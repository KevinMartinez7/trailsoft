CONTACT_TO_EMAIL=trailsoftoficial@gmail.com

# For initial testing Resend accepts this sender for the account email.
# Replace it with a verified domain sender before production.
CONTACT_FROM_EMAIL=TrailSoft <onboarding@resend.dev>
